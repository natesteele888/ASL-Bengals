rules_version = '2';

// Gridiron Hub — Firestore security rules for the my-gridiron-hub project.
//
// Nothing like this existed before: no firestore.rules file has ever been
// committed or deployed here, which means Firestore has been running on
// whatever default the console picked when the project was created —
// either locked to deny-all (so logins silently fail to create a user
// doc) or wide open to any signed-in — or even anonymous — visitor for
// 30 days. Deploy this file (see ADMIN_SETUP.md) to put real rules in
// place instead of guessing which default you're on.
//
// The model: every signed-in user gets exactly one users/{uid} doc,
// created on first login (see login.html's ensureUserDoc). A user can
// always read and update their own doc, but can never set their own
// role, orgId or teamIds — those three fields only move via an admin,
// which is what makes "role-based visibility" actually mean something
// instead of being an honor system. There is no admin yet on a fresh
// deploy; ADMIN_SETUP.md covers the one manual console step that bootstraps
// the first one.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return isSignedIn() && myProfile().role == 'admin'; }
    // Board runs the whole org, not one team, so they get the same reach
    // as a coach across every team rather than needing teamIds set at all.
    function isStaff() { return isSignedIn() && myProfile().role in ['admin', 'board']; }
    function isCoachOf(teamId) {
      return isSignedIn() && myProfile().role == 'coach'
        && myProfile().teamIds is list && teamId in myProfile().teamIds;
    }
    function isTeamMember(teamId) {
      return isSignedIn() && myProfile().teamIds is list && teamId in myProfile().teamIds;
    }
    function canManageTeam(teamId) { return isStaff() || isCoachOf(teamId); }

    match /users/{uid} {
      // Read your own profile, or any profile if you're an admin (the
      // admin page needs to list everyone to assign roles/teams).
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // First login ever: you may create your own doc, but only with the
      // untouched defaults — role/orgId unset, no teams. This is the one
      // write login.html's ensureUserDoc performs.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == null
        && request.resource.data.orgId == null
        && request.resource.data.teamIds is list
        && request.resource.data.teamIds.size() == 0;

      // After that: you may update your own doc as long as role, orgId
      // and teamIds come out unchanged (so a display-name edit is fine,
      // self-promoting to admin is not). An admin may update anyone's
      // doc, including those three fields — that's the actual assignment
      // flow the admin page uses.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.orgId == resource.data.orgId
          && request.resource.data.teamIds == resource.data.teamIds)
        || isAdmin()
      );

      allow delete: if false;
    }

    // Per-team data: team.html already has this fully built (roster, a
    // banner photo, announcements, a practice schedule with RSVPs) and has
    // been silently failing every read and write since it was written,
    // for lack of any rule at all. The team doc and its practice events
    // are public on purpose -- a practice time or "practice cancelled"
    // notice is exactly the kind of thing a parent needs to see without
    // first creating an account. The roster (kids' names and numbers),
    // RSVPs and the team message board are NOT: only the team's own
    // members and the people who run it can read those.
    match /teams/{teamId} {
      allow read: if true;
      // The banner-photo update (team.html's only direct write here).
      allow write: if canManageTeam(teamId);

      match /roster/{playerId} {
        allow read: if isTeamMember(teamId) || canManageTeam(teamId);
        allow write: if canManageTeam(teamId);
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, update: if canManageTeam(teamId);
        allow delete: if false;

        // Doc id IS the uid (team.html does setDoc(..., 'rsvps', uid)),
        // so there's no separate uid field to check -- just that it's you,
        // and that you actually belong to this team (or run it).
        match /rsvps/{uid} {
          allow read: if isTeamMember(teamId) || canManageTeam(teamId);
          allow write: if isSignedIn() && request.auth.uid == uid
            && (isTeamMember(teamId) || canManageTeam(teamId));
        }
      }

      // Two-way on purpose: any team member can post, not just a coach --
      // that's the difference between this and a one-way announcement
      // feed. readBy is how "seen by" works: anyone who can already read
      // the message can add themselves to it, and nothing else about an
      // existing message is editable once posted.
      match /messages/{msgId} {
        allow read: if isTeamMember(teamId) || canManageTeam(teamId);
        allow create: if isSignedIn()
          && request.resource.data.postedBy == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && (isTeamMember(teamId) || canManageTeam(teamId));
        allow update: if isSignedIn()
          && (isTeamMember(teamId) || canManageTeam(teamId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if isSignedIn() && (resource.data.postedBy == request.auth.uid || canManageTeam(teamId));
      }

      // photos.html and player.html's tagged-photo lookup both depend on
      // this -- same gap as everything above, just not covered by that
      // work since photos also need Firebase Storage turned on (a Blaze
      // billing decision, not a rules one) before uploads actually work.
      // This half is ready regardless: the Firestore record of a photo
      // (its Storage URL, who uploaded it, which players are tagged) is
      // plain data with no billing dependency of its own.
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uploadedByUid == request.auth.uid
          && (isTeamMember(teamId) || canManageTeam(teamId));
        allow delete: if isSignedIn() && (resource.data.uploadedByUid == request.auth.uid || canManageTeam(teamId));
      }
    }

    // Nothing else exists yet. Default-deny keeps a future collection
    // safe-by-default until it gets its own rule written on purpose.
    match /{document=**} { allow read, write: if false; }
  }
}
